/* ============================
   SERVICE WORKER OFICIAL
   Cachea la web para modo offline
   Blindado para evitar errores
============================ */

const CACHE_NAME = "peguerinos-cache-v1";

const urlsToCache = [
  "index.html",
  "actividades_eventos.html",
  "calendario_2026.html",
  "galeria.html",
  "historia_peña.html",
  "contacto.html",
  "enlaces.html",
  "acceso-socios.html",
  "css/style.css",
  "js/evento_auto.js",
  "js/aviso_socio.js",
  "js/contador_visitas.js",
  "peña1.jpeg",
  "toro_enfadado.gif"
];

// INSTALACIÓN
self.addEventListener("install", event => {
  event.waitUntil(
    caches.open(CACHE_NAME).then(cache => {
      return cache.addAll(urlsToCache);
    })
  );
});

// ACTIVACIÓN
self.addEventListener("activate", event => {
  event.waitUntil(
    caches.keys().then(keys => {
      return Promise.all(
        keys.map(key => {
          if (key !== CACHE_NAME) {
            return caches.delete(key);
          }
        })
      );
    })
  );
});

// FETCH (modo offline)
self.addEventListener("fetch", event => {
  event.respondWith(
    caches.match(event.request).then(response => {
      return response || fetch(event.request);
    })
  );
});
